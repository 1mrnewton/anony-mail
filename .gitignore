/target

# Environment / secrets (keep the checked-in template)
.env
.env.*
!.env.example

# TLS certificates and private keys
*.pem
*.key
*.crt
# ...but Apple's public App Attest root CA is embedded into the binary
!src/apple_app_attest_root_ca.pem

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
docs/

# Runtime logs
*.log
*.log.txt
# ---- Required ----

# Comma-separated list of domains this server accepts mail for.
# An MX record for each domain must point at this server's public IP.
DOMAINS=example.com,mail.example.com

# ---- Database ----

# Connection string. The backend is auto-detected from the scheme.
# Defaults to a local SQLite file if unset; in Docker, point this at a path on
# a mounted volume so data persists across container restarts.
DATABASE_URL=sqlite://data/anony-mail.db
#
# To use PostgreSQL instead, set a postgres:// URL:
# DATABASE_URL=postgres://anonymail:anonymail@localhost:5432/anonymail

# Max connections in the database pool. 0 keeps the backend default
# (PostgreSQL 10, SQLite 5).
DB_MAX_CONNECTIONS=0

# ---- Networking ----

# SMTP receiver bind address. Port 25 requires root or CAP_NET_BIND_SERVICE.
SMTP_BIND_ADDR=0.0.0.0:25

# HTTP API bind address.
API_BIND_ADDR=0.0.0.0:8080

# Hostname announced in the SMTP banner/EHLO. Defaults to the first domain.
# SMTP_HOSTNAME=mail.example.com

# ---- Mailbox lifecycle ----

# How long a newly created mailbox lives, in seconds (default 1 hour).
DEFAULT_TTL_SECONDS=3600

# How often expired mailboxes are purged, in seconds.
CLEANUP_INTERVAL_SECONDS=300

# ---- SMTP hygiene limits ----

# Largest accepted message in bytes (default 25 MiB).
MAX_MESSAGE_SIZE_BYTES=26214400

# Max recipients per SMTP transaction.
MAX_RECIPIENTS=10

# Max concurrent SMTP connections (server-wide).
MAX_CONNECTIONS=1024

# Idle/session timeout for a single SMTP connection, in seconds.
SMTP_SESSION_TIMEOUT_SECONDS=60

# Max new SMTP connections from a single IP per 60s window.
SMTP_PER_IP_CONNECTIONS_PER_MIN=60

# ---- Optional STARTTLS ----
# Set both to enable STARTTLS on the SMTP listener (PEM files).
# TLS_CERT_PATH=/etc/anony-mail/tls/fullchain.pem
# TLS_KEY_PATH=/etc/anony-mail/tls/privkey.pem

# ---- HTTP ----

# Comma-separated allowed CORS origins, or * for any.
CORS_ALLOWED_ORIGINS=*

# ---- Abuse protection ----

# Extra local parts that cannot be claimed via the API, merged with the
# built-in reserved set (RFC 2142 role addresses, CA/Browser-Forum
# domain-validation names, and common operator/system names).
# RESERVED_LOCAL_PARTS=billing,ceo

# General per-IP API rate limit: sustained requests/second and burst budget.
# Set the rate to 0 to disable.
API_RATE_LIMIT_PER_SECOND=20
API_RATE_LIMIT_BURST=50

# Stricter per-IP limit on POST /api/addresses: sustained creates/minute and
# burst budget. Set the rate to 0 to disable.
API_CREATE_RATE_LIMIT_PER_MINUTE=30
API_CREATE_RATE_LIMIT_BURST=10

# Max addresses a single IP may create per UTC day (0 disables).
MAX_ADDRESSES_PER_IP_PER_DAY=200

# Request timeout for non-SSE HTTP routes, in seconds (0 disables). The SSE
# events endpoint is exempt: streams are long-lived by design.
API_REQUEST_TIMEOUT_SECONDS=30

# Concurrent SSE event streams: server-wide cap and per-IP cap (0 disables).
SSE_MAX_CONCURRENT=512
SSE_MAX_PER_IP=8

# Trust X-Forwarded-For / X-Real-IP / Forwarded headers for the client IP.
# Enable ONLY when running behind a reverse proxy that always sets them;
# otherwise clients could spoof their IP to evade rate limits.
API_TRUST_PROXY_HEADERS=false

# Serve Scalar at /docs and the OpenAPI document at /openapi.json.
# Set to false to hide both.
API_DOCS_ENABLED=true

# Serve the hosted service's legal pages at /tos and /privacy.
# Off by default: the embedded text names the hosted operator (Anony Mail),
# so leave this disabled on self-hosted instances.
LEGAL_PAGES_ENABLED=false

# Per-mailbox storage quotas: when exceeded the OLDEST messages are dropped
# (newest-wins suits OTP/signup flows). 0 disables a cap.
MAX_MESSAGES_PER_MAILBOX=50
MAX_MAILBOX_BYTES=41943040

# Refuse SMTP DATA (452, sender retries later) when the database volume has
# less than this many bytes free. Applies to the SQLite backend only; 0
# disables.
MIN_FREE_DISK_BYTES=268435456

# ---- Web Push (optional) ----
# Set BOTH keys to enable push; generate a VAPID keypair once, e.g.:
#   npx web-push generate-vapid-keys
# The private key is a secret - keep it out of version control.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
# Contact URI sent to push services (VAPID `sub` claim). Defaults to
# mailto:postmaster@<first domain>.
# VAPID_SUBJECT=mailto:ops@example.com

# ---- APNs / native iOS push (optional) ----
# Set ALL of team ID, key ID, topic, and the signing key to enable push to
# native iOS apps. Create an "Apple Push Notifications service (APNs)" key in
# the Apple Developer portal (Certificates, Identifiers & Profiles -> Keys);
# you get a .p8 file (downloadable once), its Key ID, and your Team ID.
# APNS_TEAM_ID=AB12CD34EF
# APNS_KEY_ID=XY98ZW76VU
# The app's bundle identifier (the APNs topic).
# APNS_TOPIC=com.example.anonymail
# The .p8 key itself - provide exactly one of:
#   a path to the file (mount it into the container), or
#   the file base64-encoded inline (`base64 -i AuthKey_XY98ZW76VU.p8`).
# APNS_KEY_PATH=/secrets/AuthKey_XY98ZW76VU.p8
# APNS_KEY_BASE64=
# Send through Apple's sandbox gateway instead of production. Only for Xcode
# debug builds of the app; TestFlight and App Store builds use production.
# APNS_SANDBOX=false

# Max push subscriptions per mailbox, all kinds combined (0 disables the cap).
MAX_SUBSCRIPTIONS_PER_MAILBOX=5

# ---- Custom domains ----
# Let clients claim a domain they own, prove control via DNS (a TXT challenge
# at _anonymail.<domain> plus an MX record pointing at SMTP_HOSTNAME), and
# receive mail on it. Verified domains are re-checked daily; broken DNS is
# tolerated for a ~48h grace window before the domain stops receiving.
CUSTOM_DOMAINS_ENABLED=true

# Max custom-domain claims a single IP may create per UTC day (0 disables).
MAX_CUSTOM_DOMAINS_PER_IP_PER_DAY=5

# Min seconds between DNS verification runs for one domain (0 disables).
CUSTOM_DOMAIN_VERIFY_THROTTLE_SECONDS=10

# ---- Entitlements / tiers (optional; for hosted instances) ----
# Enforce free/pro limits server-side. OFF by default: a self-hosted server
# has every feature available to any client, no tokens required. When on,
# clients prove their tier via POST /api/entitlements/verify (RevenueCat
# purchase check) and send the returned token as X-Client-Token; requests
# without one are free tier. GET /api/capabilities reports the policy.
# ENTITLEMENTS_ENFORCED=false
#
# Key for signing client tokens (HS256). Base64, at least 32 bytes — generate
# with: openssl rand -base64 32
# Required when ENTITLEMENTS_ENFORCED=true (or when REVENUECAT_SECRET_KEY is
# set); also the availability switch for POST /api/entitlements/verify.
# TOKEN_SIGNING_KEY=
#
# RevenueCat secret API key (sk_...). Enables pro verification; without it
# every client is free tier (with a loud warning when enforcement is on).
# REVENUECAT_SECRET_KEY=
# The RevenueCat entitlement identifier that marks a subscriber as pro.
# REVENUECAT_ENTITLEMENT_ID=Anony Mail Pro
#
# Free-tier policy (only meaningful with ENTITLEMENTS_ENFORCED=true).
# Active-mailbox cap per device (0 = unlimited). Enforced per attested device,
# so it only bites for requests carrying an App Attest token (see below).
# FREE_ACTIVE_MAILBOXES=5
# Ceiling on a mailbox's total lifetime (expires_at - created_at, extends
# included), seconds; 0 = unlimited. Manual extends stay free below it.
# FREE_MAX_LIFETIME_SECONDS=86400
# May free clients pick a custom local part?
# FREE_CUSTOM_LOCAL_PARTS=false
# How many configured DOMAINS are usable free, from the front (0 = all).
# FREE_DOMAIN_COUNT=1
# May free clients claim bring-your-own domains?
# FREE_CUSTOM_DOMAINS=false
#
# Pro-tier ceilings (abuse limits, not sales gates).
# PRO_ACTIVE_MAILBOXES=50
# PRO_MAX_LIFETIME_SECONDS=0

# ---- Client attestation / App Attest (optional; for hosted instances) ----
# Prove that writes come from a genuine build of the official iOS app
# (Apple App Attest, verified locally — the server never calls Apple).
# OFF by default: self-hosted servers stay fully open to any client.
#
# Set BOTH ids to enable the /api/client/* endpoints (challenge, attest,
# assert). Requires TOKEN_SIGNING_KEY (the minted tokens are signed with it).
# Your Apple Developer Team ID:
# APP_ATTEST_TEAM_ID=AB12CD34EF
# The app's bundle identifier:
# APP_ATTEST_BUNDLE_ID=com.example.anonymail
#
# Flip on to REQUIRE an attested client token on every mutating route
# (reads stay open). Only makes sense on the hosted instance, after the
# app release with attestation support has rolled out.
# CLIENT_ATTESTATION_REQUIRED=false
#
# Override the embedded Apple App Attestation Root CA (PEM). Only needed if
# Apple rotates the root before this binary is rebuilt.
# APP_ATTEST_ROOT_CA_PATH=/secrets/Apple_App_Attestation_Root_CA.pem

# ---- Delivery behavior ----
# Plus-addressing is always on: mail to user+tag@domain delivers to user@domain.
#
# Auto-create a mailbox (default TTL) when mail arrives for an unknown local
# part on an accepted domain (never on custom domains). Reserved local parts
# are never auto-created.
CATCH_ALL_ENABLED=false

# Retain the original RFC 5322 bytes of each message and serve them at
# GET /api/addresses/{address}/messages/{id}/raw as a .eml download.
# Roughly doubles per-message storage (raw_size already counts toward
# MAX_MAILBOX_BYTES either way).
STORE_RAW_MESSAGE=false

# ---- Logging ----
# tracing/env-filter directive.
RUST_LOG=info,anony_mail=debug
